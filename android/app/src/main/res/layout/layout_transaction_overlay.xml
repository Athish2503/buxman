<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="20dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:maxWidth="400dp"
        app:cardBackgroundColor="#0D0E14"
        app:cardCornerRadius="28dp"
        app:cardElevation="24dp"
        app:strokeColor="#25FFFFFF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header Title Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Small Pulsing Indicator Dot -->
                    <ImageView
                        android:id="@+id/iv_header_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@android:drawable/presence_online"
                        app:tint="#7C3AED" />

                    <TextView
                        android:id="@+id/tv_source_app"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.2"
                        android:text="FINANCE AUTOPILOT"
                        android:textColor="#7C3AED"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Close Button -->
                <ImageButton
                    android:id="@+id/btn_close_overlay"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#50FFFFFF" />
            </RelativeLayout>

            <!-- Amount Block (Neo-banking focus) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_overlay_input"
                android:paddingVertical="20dp"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tv_amount_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="TRANSACTION VALUE"
                    android:textColor="#66FFFFFF"
                    android:textSize="9sp"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_overlay_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="₹0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp"
                    android:lineSpacingMultiplier="0.9" />

                <TextView
                    android:id="@+id/tv_overlay_merchant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="MERCHANT"
                    android:textColor="#E2E8F0"
                    android:textSize="15sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Category Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.15"
                android:text="ASSIGN CATEGORY"
                android:textColor="#66FFFFFF"
                android:textSize="9sp"
                android:layout_marginStart="2dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:scrollbars="none"
                android:overScrollMode="never">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_overlay_categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:chipSpacingHorizontal="6dp"/>
            </HorizontalScrollView>

            <!-- Notes Memo Box -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.15"
                android:text="MEMO &amp; NOTES"
                android:textColor="#66FFFFFF"
                android:textSize="9sp"
                android:layout_marginStart="2dp" />

            <EditText
                android:id="@+id/et_overlay_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_overlay_input"
                android:fontFamily="sans-serif-medium"
                android:hint="What was this expense for?"
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#44FFFFFF"
                android:textSize="13sp"
                android:inputType="textCapSentences" />

            <!-- Reimbursable Toggle Switch -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_reimbursable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Mark as reimbursable expense"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                app:thumbTint="#7C3AED"
                app:trackTint="#407C3AED"
                android:layout_marginStart="2dp" />

            <!-- Actions buttons layout -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_overlay_save"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#7C3AED"
                android:fontFamily="sans-serif-black"
                android:text="APPROVE LOG"
                android:textColor="#FFFFFF"
                android:textAllCaps="true"
                android:textSize="13sp"
                android:letterSpacing="0.15"
                app:cornerRadius="16dp"
                app:rippleColor="#33FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_overlay_dismiss"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-bold"
                android:text="Ignore Transaction"
                android:textColor="#55FFFFFF"
                android:textSize="12sp"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- Success Animation Layer (Centred, expanding) -->
        <FrameLayout
            android:id="@+id/layout_success_animation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F90D0E14"
            android:clickable="true"
            android:focusable="true"
            android:alpha="0"
            android:visibility="gone">

            <!-- Expand aura ring -->
            <View
                android:id="@+id/view_burst_ring"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:background="@drawable/shape_success_burst_ring"
                android:scaleX="0.2"
                android:scaleY="0.2"
                android:alpha="0" />

            <!-- Center Green Success Circle & Tick -->
            <ImageView
                android:id="@+id/iv_success_tick"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_success_tick"
                android:scaleX="0"
                android:scaleY="0" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>
